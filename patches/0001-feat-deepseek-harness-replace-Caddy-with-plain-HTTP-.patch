+  process.stdout.write(
+    `dsh-node-proxy listening on ${listenHost}:${port} -> ${backendHost}:${backendPort} ` +
+    `(plain HTTP, no authentication; allowed hosts: ${accessHosts.join(', ')}` +
+    `${sharedSecret === '' ? '' : '; shared secret required'})\n`,
+  )
+})
