+  upstream.on('error', () => socket.destroy())
+  upstream.on('close', () => {
+    if (!logged) logUpgrade(request, remote, 0, startedAt)
+    socket.destroy()
+  })
+  socket.on('error', () => upstream.destroy())
+  socket.on('close', () => {
+    if (!logged) logUpgrade(request, remote, 0, startedAt)
+    upstream.destroy()
+  })
+  socket.setTimeout(0)
+  upstream.setTimeout(0)
+})
